<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Win32 Bluetooth APIs (BluetoothApis.dll); same TFM as other plugins. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x86</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <RootDir>$([System.IO.Path]::GetFullPath('$(SolutionDir)..'))</RootDir>
    <MainProjectBuildDir>$(RootDir)\AgileInspect\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)</MainProjectBuildDir>
    <!-- Main app stays net8.0-windows; copy plugin into that output folder -->
    <PluginOutputDir>$(RootDir)\AgileInspect\bin\$(Platforms)\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\dll\UnknownBluetoothPlugin</PluginOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid MSBuild cycle: building this plugin builds AgileInspect; skip BuildPlugins on that inner build. -->
    <ProjectReference Include="..\AgileInspect\AgileInspect.csproj">
      <AdditionalProperties>DisablePluginRecursiveBuild=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPluginWithDependencies" AfterTargets="Build">
    <Message Text="PluginOutputDir = $(PluginOutputDir)" Importance="High" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutputDir)" SkipUnchangedFiles="true" />

    <ItemGroup>
      <DependencyFiles Include="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
    <Copy SourceFiles="@(DependencyFiles)" DestinationFolder="$(PluginOutputDir)\libs" SkipUnchangedFiles="true" />

    <ItemGroup>
      <FilesToDelete Include="$(PluginOutputDir)\libs\*AgileInspect*.dll" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
  </Target>
</Project>
