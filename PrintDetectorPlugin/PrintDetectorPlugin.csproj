<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>false</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<Configurations>Debug;Release</Configurations>
		<Platforms>x86</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<RootDir>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\'))</RootDir>
		<MainProjectBuildDir>$(RootDir)\AgileInspect\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)</MainProjectBuildDir>
		<PluginOutputDir>$(RootDir)\AgileInspect\bin\$(Platforms)\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\dll\PrintDetectorPlugin</PluginOutputDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AgileInspect\AgileInspect.csproj" />
	</ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="System.Management" Version="8.0.0" />
    </ItemGroup>

	<Target Name="CopyPluginWithDependencies" AfterTargets="Build">
		<Message Text="PluginOutputDir = $(PluginOutputDir)" Importance="High" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutputDir)" SkipUnchangedFiles="true" />

		<ItemGroup>
			<DependencyFiles Include="@(ReferenceCopyLocalPaths)" />
	</ItemGroup>
		<Copy SourceFiles="@(DependencyFiles)" DestinationFolder="$(PluginOutputDir)\libs" SkipUnchangedFiles="true" />

		<ItemGroup>
			<FilesToDelete Include="$(PluginOutputDir)\libs\*AgileInspect*.dll" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)" />
	</Target>
</Project>