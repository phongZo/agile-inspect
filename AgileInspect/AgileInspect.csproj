<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <DebugType>none</DebugType>
    <MainProjectDll>AgileInspect.dll</MainProjectDll>
    <RootDir>$([System.IO.Path]::GetFullPath('$(SolutionDir)..'))\</RootDir>
    <Platforms>x86</Platforms>
	<RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <DebugType>full</DebugType>
  </PropertyGroup>
  <!--Plugin list -->
  <ItemGroup>
	  <PluginProjects Include="WatermarkDetectorPlugin;BrightnessChangePlugin;AntivirusDetectorPlugin;FirewallDetectorPlugin;InternetDetectorPlugin;VpnDetectorPlugin;ExternalDiskDetectorPlugin;HostFileMonitorPlugin;FocusWindowDetectorPlugin;PrintScreenDetectorPlugin;AiInteractionDetectorPlugin;PrintDetectorPlugin;ClipboardMonitorPlugin;ScreenLockPlugin;AutoUpdatePlugin;UserPlugin;SecureBootPlugin;RdpPlugin;DevModePlugin;RemoteAccessToolsPlugin;CloudSyncClientsPlugin;PersonalMessagingAppsPlugin;UsbDevicePlugin;UnknownBluetoothPlugin;ScreenSharingPlugin;VirtualMachinePlugin" />
  </ItemGroup>

  <Target Name="BuildPlugins" AfterTargets="Build" Condition="'$(DisablePluginRecursiveBuild)' != 'true'">
    <MSBuild Projects="@(PluginProjects->'..\\%(Identity)\\%(Identity).csproj')" Targets="Build" />
  </Target>

  <!-- Publish plugin -->
  <Target Name="PublishPlugins" AfterTargets="Publish">
    <MSBuild Projects="@(PluginProjects->'..\\%(Identity)\\%(Identity).csproj')" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);TargetFramework=$(TargetFramework);SelfContained=false;PublishSingleFile=false" />
  </Target>


  <Target Name="CopyPluginsAfterPublish" AfterTargets="PublishPlugins">
    <ItemGroup>
      <PluginPublishFiles Include="..\%(PluginProjects.Identity)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\**\*.dll">
        <PluginName>%(PluginProjects.Identity)</PluginName>
      </PluginPublishFiles>
      <PluginPublishFiles Include="..\%(PluginProjects.Identity)\bin\$(Configuration)\$(RuntimeIdentifier)\publish\**\*.dll">
        <PluginName>%(PluginProjects.Identity)</PluginName>
      </PluginPublishFiles>
    </ItemGroup>

    <ItemGroup>
      <!-- Identify Main DLL -->
      <MainDllFiles Include="@(PluginPublishFiles)" Condition="'%(Filename)%(Extension)' == '%(PluginName).dll'" />
      
      <!-- Identify Native DLLs by common relative paths in publish folder -->
      <NativeDllFilesX86 Include="@(PluginPublishFiles)" Condition="'%(RecursiveDir)' == 'x86\' or '%(RecursiveDir)' == '$(RuntimeIdentifier)\x86\'" />
      <NativeDllFilesX64 Include="@(PluginPublishFiles)" Condition="'%(RecursiveDir)' == 'x64\' or '%(RecursiveDir)' == '$(RuntimeIdentifier)\x64\'" />
      
      <!-- All other DLLs are dependencies-->
      <DependencyDllFiles Include="@(PluginPublishFiles)" Condition="'%(Filename)%(Extension)' != '%(PluginName).dll'" />
      <DependencyDllFiles Remove="@(NativeDllFilesX86)" />
      <DependencyDllFiles Remove="@(NativeDllFilesX64)" />
    </ItemGroup>

    <!-- Copy Main DLL -->
    <Copy SourceFiles="@(MainDllFiles)" DestinationFiles="@(MainDllFiles->'$(PublishDir)dll\\%(PluginName)\\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- Copy Dependency DLLs -->
    <Copy SourceFiles="@(DependencyDllFiles)" DestinationFiles="@(DependencyDllFiles->'$(PublishDir)dll\\%(PluginName)\\libs\\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- Copy Native DLLs (Preserve x86/x64 structure) -->
    <Copy SourceFiles="@(NativeDllFilesX86)" DestinationFolder="$(PublishDir)dll\%(PluginName)\libs\x86" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeDllFilesX64)" DestinationFolder="$(PublishDir)dll\%(PluginName)\libs\x64" SkipUnchangedFiles="true" />

    <!-- Delete copied AgileInspect*.dll in libs folder -->
    <ItemGroup>
      <AgileInspectDllsToDelete Include="$(PublishDir)dll\**\libs\*AgileInspect*.dll" />
    </ItemGroup>
    <Delete Files="@(AgileInspectDllsToDelete)" />
  </Target>
  <!--
  <Target Name="CopyStoreCfgAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="$(RootDir)store.cfg" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyStoreCfgAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(RootDir)store.cfg" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  -->
  <Target Name="RemoveEmptyLibFolders" AfterTargets="CopyPluginsAfterPublish">
    <!-- Delete all 'libs' folders that no longer contain any files (including sub-folders) -->
    <Exec Command="&#xD;&#xA;    powershell -NoProfile -ExecutionPolicy Bypass -Command ^&#xD;&#xA;      Get-ChildItem -Directory -Path '$(PublishDir)dll' -Recurse -Filter libs ^| ^&#xD;&#xA;      Where-Object { -not (Get-ChildItem -File -Path $_.FullName) } ^| ^&#xD;&#xA;      Remove-Item -Recurse&#xD;&#xA;  " />
  </Target>
</Project>