<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Configurations>Debug;Release;inspect</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <RootDir>$([System.IO.Path]::GetFullPath('$(SolutionDir)..'))</RootDir>
    <PluginOutputDir>$(RootDir)\AgileMark\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\inspect</PluginOutputDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='inspect|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <Target Name="CopyPluginWithDependencies" AfterTargets="Build">
    <Message Importance="high" Text="TargetPath: $(TargetPath)" />
    <Message Importance="high" Text="PluginOutputDir: $(PluginOutputDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutputDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
