<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <DebugType>none</DebugType>
    <MainProjectDll>AgileInspect.dll</MainProjectDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--Plugin list -->
  <ItemGroup>
    <PluginProjects Include="WatermarkDetectorPlugin" />
  </ItemGroup>
  
  <Target Name="BuildPlugins" AfterTargets="Build">
    <MSBuild Projects="@(PluginProjects->'..\\%(Identity)\\%(Identity).csproj')" Targets="Build" />
  </Target>
  
  <!-- Publish plugin -->
  <Target Name="PublishPlugins" AfterTargets="Publish">
    <MSBuild Projects="@(PluginProjects->'..\\%(Identity)\\%(Identity).csproj')" Targets="Publish" Properties="SelfContained=false;PublishSingleFile=false" />
  </Target>

  <Target Name="CopyPluginsAfterPublish" AfterTargets="PublishPlugins">
    <ItemGroup>
      <!-- Get all DLL in publish dir of each plugin -->
      <PluginPublishFiles Include="..\%(PluginProjects.Identity)\bin\$(Configuration)\net8.0-windows\win-x64\publish\win-x64\**\*.dll">
        <PluginName>%(PluginProjects.Identity)</PluginName>
      </PluginPublishFiles>

      <!-- Remove main DLL -->
      <PluginPublishFiles Remove="..\**\$(MainProjectDll)" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginPublishFiles)" DestinationFiles="@(PluginPublishFiles->'$(PublishDir)%(PluginName)\\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <Message Text="Copied ALL plugin DLLs to $(PublishDir), excluding $(MainProjectDll)" Importance="high" />
  </Target>
</Project>